#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_root"

required_files="
configs/memhub.yaml
.memhub/knowledge.yaml
configs/knowledge-publication.json
.memhub/agents/codex.json
.memhub/agents/claude.json
.memhub/agents/kimi.json
.memhub/agents/qoder.json
AGENTS.md
CLAUDE.md
PROJECT_AGENT.md
"

for path in $required_files; do
  if [ ! -s "$path" ]; then
    echo "missing required MemHub initialization artifact: $path" >&2
    exit 1
  fi
done

python3 -m json.tool configs/knowledge-publication.json >/dev/null
for binding in .memhub/agents/*.json; do
  python3 -m json.tool "$binding" >/dev/null
done

for path in configs/memhub.yaml .memhub/knowledge.yaml configs/knowledge-publication.json; do
  if ! grep -q 'airlock' "$path"; then
    echo "project identity missing from $path" >&2
    exit 1
  fi
done

if ! grep -q 'jira_project_key: AIR' configs/memhub.yaml ||
   ! grep -q 'initialization_issue: AIR-1' configs/memhub.yaml ||
   ! grep -q '"jira_issue": "AIR-1"' configs/knowledge-publication.json; then
  echo "Jira initialization binding is incomplete" >&2
  exit 1
fi

if ! grep -q 'consumer/ingest' AGENTS.md || ! grep -q 'consumer/ingest' CLAUDE.md; then
  echo "composite commit-memory convention is incomplete" >&2
  exit 1
fi

echo "MemHub initialization artifacts are complete"
